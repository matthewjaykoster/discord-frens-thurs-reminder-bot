{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vitest: Functional Google Sheets",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "test:functional",
                "--",
                "--inspect-brk"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "envFile": "${workspaceFolder}/.env",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
