{
    "name": "discord-frens-thurs-reminder-bot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:functional": "vitest run tests/google-sheets.functional.test.ts",
        "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html"
    },
    "dependencies": {
        "discord.js": "^14.17.3",
        "dotenv": "^16.4.5",
        "googleapis": "^144.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.1",
        "@vitest/coverage-v8": "^2.1.9",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    }
}
